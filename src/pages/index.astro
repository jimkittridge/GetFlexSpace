---
import { getCollection, getEntry } from 'astro:content';
import { homepageImage, portfolioRange, scriptJson } from '../lib/homepage';
import '../styles/homepage.css';
import TourInquiry from '../components/TourInquiry.astro';

const cms = (await getEntry('pages', 'homepage'))!.data;
const contact = (await getEntry('pages', 'contact'))!.data;
const locations = await getCollection('locations');
const preferredOrder = ['durham-nc', 'asheville-nc', 'columbia-sc'];
locations.sort((a, b) => {
  const aIndex = preferredOrder.indexOf(a.data.slug);
  const bIndex = preferredOrder.indexOf(b.data.slug);
  return (aIndex < 0 ? 99 : aIndex) - (bIndex < 0 ? 99 : bIndex) || a.data.name.localeCompare(b.data.name);
});
const markets = await Promise.all(locations.map(async ({data}, i) => ({
  name: data.name, fullName: data.fullName, state: data.state,
  stateName: data.state === 'NC' ? 'North Carolina' : data.state === 'SC' ? 'South Carolina' : data.state,
  index: String(i + 1).padStart(2, '0'),
  image: await homepageImage(data.image), cardImage: await homepageImage(data.image, 720),
  range: data.specs.suiteRange, available: data.availability === 'available',
  door: data.specs.doorSize, height: data.specs.ceilingHeight, power: data.specs.power,
  lease: data.specs.lease, url: `/locations/${data.slug}/`,
  description: (data.homepageDescription || `Explore warehouse and flex space in ${data.fullName}, with {{suiteRange}} suites. Contact leasing for current availability and property details.`).replaceAll('{{suiteRange}}', data.specs.suiteRange),
})));
const featured = markets[0];
const suiteRange = portfolioRange(markets.map(market => market.range));
const suiteRanges = markets.map(market => `${market.name}: ${market.range}`).join('; ');
const faq = (cms.faq || []).map(item => ({...item, answer: item.answer.replaceAll('{{suiteRanges}}', suiteRanges)}));
const logo = await homepageImage(cms.logo || '/images/brand/getflexspace-color.svg', 420);
const telHref = `tel:${contact.phoneHref}`;
const smsHref = `sms:${contact.phoneHref}`;
const emailHref = `mailto:${contact.email}`;
const canonical = 'https://getflexspace.com/';
const structuredData = {
  '@context': 'https://schema.org', '@graph': [
    {'@type': 'Organization', '@id': `${canonical}#organization`, name: 'GetFlexSpace', url: canonical,
      logo: new URL(logo, canonical).href, description: cms.seo.description,
      telephone: contact.phoneHref, email: contact.email,
      areaServed: ['North Carolina', 'South Carolina'].map(name => ({'@type': 'State', name}))},
    {'@type': 'ItemList', name: 'GetFlexSpace locations', itemListElement: markets.map((market, i) => ({
      '@type': 'ListItem', position: i + 1, name: `Warehouse & flex space in ${market.fullName}`,
      url: new URL(market.url, canonical).href}))},
    {'@type': 'FAQPage', mainEntity: faq.map(item => ({'@type': 'Question', name: item.question,
      acceptedAnswer: {'@type': 'Answer', text: item.answer}}))},
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{cms.seo.title}</title>
  <meta name="description" content={cms.seo.description}/>
  <link rel="canonical" href={canonical}/>
  <meta name="theme-color" content="#f5f3ee"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <meta property="og:title" content={cms.seo.title}/><meta property="og:description" content={cms.seo.description}/>
  <meta property="og:type" content="website"/><meta property="og:url" content={canonical}/>
  <meta property="og:image" content={new URL(featured.image, canonical).href}/>
  <meta property="og:image:alt" content={`Warehouse and flex space in ${featured.fullName}`}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <script type="application/ld+json" set:html={scriptJson(structuredData)}/>
</head>
<body>
<a href="#main" class="skip">Skip to content</a>
<header class="site-header">
  <a class="brand" href="/" aria-label="GetFlexSpace home"><img src={logo} alt="GetFlexSpace" width="1243" height="228"></a>
  <nav id="navigation" aria-label="Main navigation"><a href="#locations">Our locations</a><a href="#your-business">Built for business</a><a href="#questions">FAQs</a></nav>
  <div class="header-actions"><a href={telHref} class="call-link"><svg aria-hidden="true"><use href="#phone"/></svg>Call leasing</a><a class="button dark" href="/contact/" data-tour>Request a tour <span aria-hidden="true">↗</span></a><button class="menu" aria-label="Open menu" aria-expanded="false" aria-controls="navigation"><svg aria-hidden="true"><use href="#menu"/></svg></button></div>
</header>
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="orange-mark"></span>YOUR BUSINESS. YOUR NEXT CHAPTER.</p>
      <p class="hero-display">Space for<br> your next<br> <em>move.</em></p>
      <h1 id="hero-title" class="hero-search-title">{cms.hero?.headline}</h1>
      <p class="hero-description">{cms.hero?.subheadline}</p>
      <div class="hero-actions"><a class="button orange" href="#locations">Find your space <span aria-hidden="true">↗</span></a><a class="text-link" href={smsHref}>Text us a question <svg aria-hidden="true"><use href="#message"/></svg></a></div>
      <p class="hero-note">{markets.length} Carolina markets. One next step.</p>
    </div>
    <div class="hero-photo" role="group" aria-roledescription="carousel" aria-label="Our locations">
      <button class="photo-rotation" type="button" aria-label="Pause location slideshow" hidden><svg class="rotation-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg><svg class="rotation-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z"/></svg><span>Pause</span></button>
      <img src={featured.image} alt={`${featured.fullName} warehouse and flex suites with drive-in access`} width="1200" height="900" fetchpriority="high">
      <div class="photo-top"><span><i></i>EXPLORE OUR SPACES</span><span id="photo-count">01 / {String(markets.length).padStart(2, '0')}</span></div>
      <div class="photo-caption"><div><p>{featured.name.toUpperCase()}, {featured.stateName.toUpperCase()}</p><strong>Your business belongs here.</strong></div><a href={featured.url} class="round-button" data-property={featured.name} aria-label={`Explore ${featured.name}`}><span aria-hidden="true">↗</span></a></div>
      <div class="photo-switch" role="group" aria-label="Choose property photo">{markets.map((market, i) => <button class:list={{active: i === 0}} data-hero={market.name} aria-pressed={i === 0}>{market.name}</button>)}</div>
    </div>
  </section>
  <div class="feature-strip" aria-label="Space features"><span><svg aria-hidden="true"><use href="#door"/></svg>Drive-in access</span><span><svg aria-hidden="true"><use href="#clock"/></svg>24/7 tenant access</span><span><svg aria-hidden="true"><use href="#building"/></svg>Warehouse + office options</span><span><svg aria-hidden="true"><use href="#people"/></svg>Talk directly with leasing</span></div>

  <section class="locations section" id="locations" aria-labelledby="locations-title">
    <div class="section-heading"><div><p class="eyebrow">FIND YOUR HOME BASE</p><h2 id="locations-title" class="preserve-lines">{cms.citySection?.heading}</h2></div><p>{cms.citySection?.subheading}</p></div>
    <div class="location-tabs" role="group" aria-label="Filter locations"><button class="selected" data-filter="all" aria-pressed="true">All locations <span>{markets.length}</span></button>{markets.map(market => <button data-filter={market.name} aria-pressed="false">{market.fullName}</button>)}</div>
    <div class="property-grid">
      {markets.map(market => <article class="property" data-city={market.name}>
        <a class="property-image" data-property={market.name} href={market.url} aria-label={`View ${market.name} property`}><img src={market.cardImage} alt={`Warehouse and flex space in ${market.fullName}`} loading="lazy" width="720" height="540"/><span class:list={['status', {available: market.available}]}><i></i>{market.available ? 'Now leasing' : 'Join the waitlist'}</span><span class="image-arrow" aria-hidden="true">↗</span></a>
        <div class="property-heading"><h3>{market.fullName}</h3><span>{market.index}</span></div>
        <p class="property-description">{market.description}</p>
        <div class="property-facts"><span>{market.range}</span><span>Drive-in access</span></div>
        <div class="property-bottom">
          <a href="/contact/" class="property-cta property-cta-primary" data-tour={market.available ? 'tour' : 'waitlist'} data-location={market.name} aria-label={market.available ? `Request a tour in ${market.name}` : `Join the waitlist in ${market.name}`}>
            {market.available ? 'Request a tour' : 'Join the waitlist'} <span aria-hidden="true">↗</span>
          </a>
          <a class="property-cta property-cta-secondary" href={market.url} aria-label={`View ${market.name} property — warehouse and flex space`}>
            View {market.name} property <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>)}
    </div>
    <div class="location-help"><span>Not sure where to start? Tell us what your business needs.</span><a class="text-link" href={smsHref}>Let’s talk <span aria-hidden="true">↗</span></a></div>
  </section>


  <section class="space-guide section" id="space-features" aria-labelledby="space-guide-title">
    <div class="space-guide-copy"><p class="eyebrow">MORE THAN A PLACE TO STORE</p><h2 id="space-guide-title">Warehouse space.<br>Room for your<br>whole operation.</h2><p>GetFlexSpace offers warehouse and flex industrial space for businesses that need a place to work, store inventory, stage equipment, or bring office and warehouse functions together.</p><p>Across our Carolina locations, suite sizes span {suiteRange}. Explore drive-in access, warehouse-plus-office layouts, and the features that support your day-to-day work. Availability and configurations vary by property.</p><a class="text-link" href="#questions">Explore common leasing questions <span aria-hidden="true">↘</span></a></div>
    <div class="space-specs">
      <div><span class="spec-label">SPACE TO WORK</span><h3>{suiteRange}</h3><p>Compare the suite sizes at each location, from a dedicated contractor workspace to room for inventory and operations.</p></div>
      <div><span class="spec-label">LOADING & STORAGE</span><h3>Drive-in doors</h3><p>Move tools, materials, and inventory into your space. Confirm door dimensions and vehicle access for your chosen suite.</p></div>
      <div><span class="spec-label">WAREHOUSE + OFFICE</span><h3>Work under one roof</h3><p>Explore layouts with office space alongside the warehouse. Office finish, restrooms, and HVAC vary by suite.</p></div>
      <div><span class="spec-label">YOUR OPERATING NEEDS</span><h3>Check the details</h3><p>Ask about clear height, electrical capacity, parking, deliveries, and your intended use before choosing a space.</p></div>
    </div>
  </section>

  <section class="business section" id="your-business" aria-labelledby="business-title">
    <div class="business-intro"><p class="eyebrow">BUILT AROUND YOUR WORK</p><h2 id="business-title"><span class="business-headline preserve-lines">{cms.useCases?.heading}</span><br><span>We’ve got<br>the space.</span></h2><p>{cms.useCases?.subheading}</p><a class="text-link" href="#locations">Find your fit <span aria-hidden="true">↗</span></a></div>
    <div class="business-list">
      {cms.useCases?.items.map((item, i) => <div class="business-row"><span class="business-number">{String(i + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><svg aria-hidden="true"><use href={`#${item.icon}`}/></svg></div>)}
      <p class="use-note">Every business is different. We’ll help confirm that your intended use fits the property.</p>
    </div>
  </section>

  <section class="steps section" aria-labelledby="steps-title"><div class="section-heading"><div><p class="eyebrow">A CLEAR PATH FORWARD</p><h2 id="steps-title">{cms.process?.heading}</h2></div><p>{cms.process?.subheading}</p></div><div class="steps-grid">{cms.process?.steps.map((step, i) => <div><span>{String(i + 1).padStart(2, '0')} / {['FIND', 'EXPLORE', 'MOVE'][i] || 'NEXT'}</span><h3>{step.title}</h3><p>{step.description}</p></div>)}</div></section>

  <section class="faq section" id="questions" aria-labelledby="faq-title"><div class="faq-intro"><p class="eyebrow">A FEW THINGS TO KNOW</p><h2 id="faq-title">Warehouse leasing.<br>Your questions,<br>answered.</h2><p>Have something specific in mind?<br>We’re happy to talk it through.</p><a class="text-link" href={smsHref}>Ask us a question <span aria-hidden="true">↗</span></a></div><div class="faq-list">
    {faq.map((item, i) => <details open={i === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
  </div></section>

  <section class="contact-banner"><div><p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p><h2>{cms.finalCta?.heading}</h2><p>{cms.finalCta?.subheading}</p></div><div class="contact-actions"><a class="button orange" href="/contact/" data-tour>Request a tour <span aria-hidden="true">↗</span></a><div><a href={telHref}>Call leasing</a><span>/</span><a href={smsHref}>Text a question</a></div><p>Direct to our leasing team.</p></div></section>
</main>
<footer><div class="footer-main"><a class="brand footer-brand" href="/" aria-label="GetFlexSpace home"><img src={logo} alt="GetFlexSpace" width="1243" height="228" loading="lazy"></a><p>Warehouse & flex space.<br>Room for what’s next.</p><div>{markets.map(market => <a href={market.url}>{market.name} warehouse &amp; flex space</a>)}</div><div><a href={telHref}>{contact.phone}</a><a href={emailHref}>{contact.email}</a><span>North Carolina & South Carolina</span></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} GetFlexSpace</span><span><a href="/about/">About us</a> · <a href="/blog/">Leasing resources</a> · <a href="/contact/">Contact</a></span></div></footer>
<div class="mobile-contact" aria-label="Contact leasing"><a class="button orange" href="/contact/" data-tour>Request a tour <span aria-hidden="true">↗</span></a><a href={telHref}><svg aria-hidden="true"><use href="#phone"/></svg>Call</a><a href={smsHref}><svg aria-hidden="true"><use href="#message"/></svg>Text</a></div>

<dialog id="property-dialog" class="property-dialog" aria-labelledby="detail-title"><button class="close-dialog" aria-label="Close property details">×</button><img id="detail-image" src={featured.image} alt=""><div class="dialog-content"><p class="eyebrow" id="detail-status"></p><h2 id="detail-title"></h2><p id="detail-description"></p><dl id="detail-facts"></dl><p class="fine-print">Suite sizes and features vary. Ask leasing to confirm current availability, pricing, and the specifications of your preferred space.</p><div class="dialog-actions"><button class="button orange" id="detail-action">Request a tour <span aria-hidden="true">↗</span></button><a class="text-link" id="detail-link" href={featured.url}>See property details ↗</a></div></div></dialog>
<TourInquiry markets={markets} phone={contact.phone!} phoneHref={contact.phoneHref!} email={contact.email!} />
<script type="application/json" id="homepage-data" set:html={scriptJson({markets, email: contact.email})}/>
<script src="../scripts/homepage.ts"></script>
<svg class="svg-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
  <symbol id="phone" viewBox="0 0 24 24"><path d="M6 3h3l2 5-2 2c1.5 3 2 3.5 5 5l2-2 5 2v3c0 2-2 3-4 2C9 18 6 15 3 7c-1-2 1-4 3-4Z"/></symbol>
  <symbol id="message" viewBox="0 0 24 24"><path d="M4 4h16v12H9l-5 4V4Z"/><path d="M8 8h8M8 12h5"/></symbol>
  <symbol id="menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
  <symbol id="door" viewBox="0 0 24 24"><path d="M3 21V3h18v18M7 21V7h10v14M7 10h10M7 14h10M7 18h10"/></symbol>
  <symbol id="clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></symbol>
  <symbol id="building" viewBox="0 0 24 24"><path d="M4 21V4h10v17M14 10h6v11M2 21h20M8 8h2M8 12h2M8 16h2M17 14v1M17 17v1"/></symbol>
  <symbol id="people" viewBox="0 0 24 24"><circle cx="9" cy="7" r="3"/><path d="M3 21v-4a6 6 0 0 1 12 0v4M16 4a3 3 0 0 1 0 6M18 13a5 5 0 0 1 3 5v3"/></symbol>
  <symbol id="tools" viewBox="0 0 24 24"><path d="m3 3 6 6M3 3l4 1-3 3-1-4Zm12 9 6 6-3 3-6-6M21 3l-5 2-2 5-10 10 2 2L16 12l5-2V3Z"/></symbol>
  <symbol id="box" viewBox="0 0 24 24"><path d="m3 7 9-5 9 5v10l-9 5-9-5V7Zm0 0 9 5 9-5M12 12v10M8 4l9 5"/></symbol>
  <symbol id="gear" viewBox="0 0 24 24"><path d="M4 21V10l6 3V7l6 3V3h4v18H4ZM8 17h1m3 0h1m3 0h1"/></symbol>
</defs></svg>
</body></html>
