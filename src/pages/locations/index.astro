---
import NewLayout from '../../layouts/NewLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import TourInquiry from '../../components/TourInquiry.astro';
import { isPublished, isRenderingImage, acquisitionNotice, propertyTypeLabel, propertyViewLabel, propertyHighlights } from '../../lib/portfolio.js';
import { getCollection, getEntry } from 'astro:content';
import { compareLocationAvailability, locationStatus, propertyAvailability, publicAvailability } from '../../lib/property.js';
import { homepageImage, portfolioRange, scriptJson } from '../../lib/homepage';
import '../../styles/locations.css';

const allLocations = (await getCollection('locations', isPublished)).sort((a, b) => compareLocationAvailability(a.data, b.data));
const contact = (await getEntry('pages', 'contact'))!.data;
const markets = await Promise.all(allLocations.map(async ({ data }) => ({
  ...data, imageIsRendering: isRenderingImage(data), availability: publicAvailability(data),
  image: await homepageImage(data.image, 960),
  available: propertyAvailability(data).acceptingTours,
  typeLabel: propertyTypeLabel(data.propertyType), features: propertyHighlights(data),
  viewLabel: propertyViewLabel(data),
  description: (data.homepageDescription || data.tagline).replaceAll('{{suiteRange}}', data.specs.suiteRange),
  url: `/locations/${data.slug}/`,
})));
const range = portfolioRange(markets.map(market => market.specs.suiteRange));
const filters = [
  { value: 'all', label: 'All locations', count: markets.length },
  ...['available', 'coming-soon', 'full'].map(value => ({
    value, label: locationStatus(value).label, count: markets.filter(market => market.availability === value).length,
  })).filter(filter => filter.count > 0),
];
const title = 'Warehouse, Flex & Retail Space Locations in NC & SC | GetFlexSpace';
const description = `Explore small-bay space, larger warehouses, and retail space in ${markets.map(market => market.fullName).join('; ')}. Compare sizes and availability.`;
const canonical = 'https://getflexspace.com/locations/';
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'CollectionPage', '@id': canonical, name: title, description, url: canonical, mainEntity: { '@id': `${canonical}#properties` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://getflexspace.com/' },
      { '@type': 'ListItem', position: 2, name: 'Locations', item: canonical },
    ] },
    { '@type': 'ItemList', '@id': `${canonical}#properties`, name: 'GetFlexSpace locations', numberOfItems: markets.length,
      itemListElement: markets.map((market, index) => ({ '@type': 'ListItem', position: index + 1, name: `${market.typeLabel} in ${market.fullName}`, url: new URL(market.url, canonical).href })) },
  ],
};
---
<NewLayout title={title} description={description} canonicalUrl={canonical} schemaMarkup={scriptJson(schema)} bodyClass="locations-page" leasingLocation="" leasingAvailable={true}>
  <a class="directory-skip" href="#property-list">Skip to properties</a>
  <div class="directory-wrap">
    <nav class="directory-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Locations</span></nav>
    <section class="directory-hero" aria-labelledby="directory-title">
      <div>
        <p class="directory-eyebrow">WAREHOUSE, FLEX & RETAIL SPACE</p>
        <h1 id="directory-title">Find your space<br/>in the <em>Carolinas.</em></h1>
        <p class="directory-intro">Compare warehouse, flex, and retail space for lease in North Carolina and South Carolina. Find your location and request a tour.</p>
      </div>
      <aside class="directory-overview" aria-label="Our locations at a glance">
        <p class="directory-eyebrow">ROOM FOR WHAT’S NEXT</p>
        <dl><div><dt>Carolina locations</dt><dd>{markets.length}</dd></div><div><dt>Building & suite sizes</dt><dd>{range}</dd></div></dl>
        <a href={`sms:${contact.phoneHref}`} class="directory-text-link">Need a hand? Text leasing <ArrowIcon/></a>
      </aside>
    </section>

    <section class="directory-list" id="property-list" aria-labelledby="property-list-title">
      <div class="directory-list-heading"><h2 id="property-list-title">Explore our locations.</h2><p>Now leasing first. Your next move, made easier.</p></div>
      <div class="directory-filters" hidden>
        <div class="directory-status-filters" role="group" aria-label="Filter by availability">{filters.map((filter, index) => <button type="button" data-location-status={filter.value} aria-pressed={index === 0} aria-label={`${filter.label}, ${filter.count} locations`} aria-controls="location-results">{filter.label}<span>{filter.count}</span></button>)}</div>
        <label class="directory-type-filter" for="location-type">Space type<select id="location-type" aria-controls="location-results"><option value="all">All space types</option><option value="flex">Small Bay Spaces</option><option value="warehouse">Larger Warehouses</option><option value="retail">Retail Space</option></select></label>
      </div>
      <p class="directory-result-count" id="location-result-count" role="status" aria-live="polite" aria-atomic="true">Showing all {markets.length} locations</p>
      <div class="directory-grid" id="location-results">
        {markets.map((market, index) => <article class="location-card" data-location-card data-availability={market.availability} data-space-type={market.propertyType} aria-labelledby={`location-${market.slug}`}>
          <a class="location-card-image" href={market.url} aria-label={market.viewLabel}>
            {market.image ? <img src={market.image} alt={`${market.typeLabel} at ${market.schema.address.street}, ${market.schema.address.city}, ${market.state}`} width="960" height="640" loading={index === 0 ? 'eager' : 'lazy'} decoding="async"/> : <div class="location-image-placeholder"><span>{market.typeLabel}</span><strong>{market.specs.suiteRange}</strong><span>{market.features.join(' · ')}</span></div>}
            <span class:list={['location-status', market.availability]}><i aria-hidden="true"></i>{locationStatus(market.availability).label}</span>
            {market.imageIsRendering && <span class="rendering-label">Proposed renovation · Illustrative rendering</span>}<span class="location-photo-arrow"><ArrowIcon/></span>
          </a>
          <div class="location-card-body">
            <div class="location-card-heading"><div><p class="directory-eyebrow">{market.typeLabel}</p><h3 id={`location-${market.slug}`}><a href={market.url}>{market.fullName}</a></h3></div><span class="location-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
            <address>{market.schema.address.street}<br/>{market.schema.address.city}, {market.schema.address.state} {market.schema.address.zip}</address>
            <p class="location-description">{market.description}{market.marketingStage === 'subject-to-acquisition' && <span class="card-marketing-note">{acquisitionNotice}</span>}</p>
            <dl class="location-card-facts"><div><dt>Suite sizes</dt><dd>{market.specs.suiteRange}</dd></div><div><dt>{market.yard ? 'Storage yard' : market.propertyType === 'retail' ? 'Customer access' : 'Loading access'}</dt><dd>{market.yard || market.specs.doorSize}</dd></div></dl>
            <div class="location-card-actions">
              <a class="directory-button" href="/contact/" data-property-inquiry={market.name} data-request-type={market.available ? 'tour' : 'waitlist'} aria-label={`${market.available ? 'Request a tour' : 'Join the waitlist'} in ${market.name}`}>{market.available ? 'Request a tour' : 'Join the waitlist'}<ArrowIcon/></a>
              <a class="directory-button secondary" href={market.url}>{market.viewLabel}<ArrowIcon/></a>
            </div>
          </div>
        </article>)}
      </div>
      <div class="directory-empty" hidden><h3>No locations match those filters.</h3><p>Try another availability or space type, or show all locations.</p><button class="directory-button" type="button" id="reset-location-filters">Show all locations <ArrowIcon/></button></div>
      <p class="directory-availability-note">Availability can change. Our leasing team will confirm the right suite, pricing, and timing for your business.</p>
    </section>

    <section class="directory-guide" aria-labelledby="directory-guide-title">
      <div><p class="directory-eyebrow">FIND THE RIGHT FIT</p><h2 id="directory-guide-title">The space is just<br/>the starting point.</h2><p>Choose the location that works for your customers, your team, and the way you do business.</p></div>
      <div class="directory-guide-options"><div><h3>Small Bay Spaces</h3><p>Explore {markets.filter(m => m.propertyType === 'flex').map(m => m.name).join(', ')} for equipment, inventory, trade businesses, and warehouse-plus-office needs. Check each property for loading access and suite details.</p></div><div><h3>Larger Warehouses & Yards</h3><p>Explore more building space and outdoor storage at our larger properties. Confirm yard access, permitted uses, and availability with leasing.</p></div><div><h3>Retail space</h3><p>Explore Morganton for storefront space on W Fleming Drive. Review available sizes and speak with leasing about your business, layout, and signage needs.</p></div></div>
    </section>

    <section class="directory-help" aria-labelledby="directory-help-title"><div><p class="directory-eyebrow">LET’S TALK SPACE</p><h2 id="directory-help-title">Tell us what you need.</h2><p>Share your preferred location, size, and move-in timing. We’ll help you explore the options.</p></div><div class="directory-help-actions"><a class="directory-button" href="/contact/" data-property-inquiry="">Request a tour <ArrowIcon/></a><div><a href={`tel:${contact.phoneHref}`}>Call {contact.phone}</a><a href={`sms:${contact.phoneHref}`}>Text leasing <ArrowIcon size={18}/></a></div></div></section>
  </div>
  <TourInquiry markets={markets} phone={contact.phone!} phoneHref={contact.phoneHref!} email={contact.email!}/>
  <svg class="directory-icon-definitions" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs><symbol id="phone" viewBox="0 0 24 24"><path d="M6 3h3l2 5-2 2c1.5 3 2 3.5 5 5l2-2 5 2v3c0 2-2 3-4 2C9 18 6 15 3 7c-1-2 1-4 3-4Z"/></symbol><symbol id="message" viewBox="0 0 24 24"><path d="M4 4h16v12H9l-5 4V4Z"/><path d="M8 8h8M8 12h5"/></symbol></defs></svg>
  <script src="../../scripts/locations.ts"></script>
</NewLayout>
