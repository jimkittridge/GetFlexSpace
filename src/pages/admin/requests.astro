---
import '../../styles/requests-admin.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="same-origin"/>
  <title>Tour requests | GetFlexSpace Admin</title><link rel="icon" href="/favicon.svg"/>
</head>
<body>
  <header class="admin-header"><a href="/admin/?view=tours" class="admin-brand">GetFlexSpace <span>Admin</span></a><nav aria-label="Admin navigation"><a href="/admin/">Content manager</a><a href="/">View site ↗</a></nav></header>
  <main>
    <div class="inbox-heading"><div><p class="eyebrow">LEASING INBOX</p><h1>Tour requests.</h1><p>Saved requests and waitlist inquiries, all in one place.</p></div></div>
    <section id="admin-login" class="login-card" aria-labelledby="login-title">
      <h2 id="login-title">One sign-in for your admin</h2>
      <p>Sign in to the content manager to manage your website and tour requests. Your inbox uses that same session automatically.</p>
      <a id="cms-sign-in" class="primary login-link" href="/admin/?view=tours">Open content manager</a>
      <p class="login-note">Tour requests stay private. Sign out from the content manager’s account menu to sign out of both.</p>
    </section>
    <p id="admin-message" role="status" aria-live="polite" hidden></p>
    <section id="admin-inbox" hidden aria-label="Saved tour requests">
      <div class="inbox-stats"><div><strong id="new-count">0</strong><span>New requests</span></div><div><strong id="scheduled-count">0</strong><span>Tours scheduled</span></div><div><strong id="total-count">0</strong><span>Total requests</span></div></div>
      <div class="inbox-toolbar"><label for="status-filter">Show<select id="status-filter"><option value="">All requests</option><option value="new">New</option><option value="contacted">Contacted</option><option value="tour_scheduled">Tour scheduled</option><option value="closed">Closed</option></select></label><button id="refresh-inbox">Refresh</button><span>Notifications: jim@rothcapital.com</span></div>
      <div id="requests-list"></div>
      <p id="empty-inbox" class="empty-state" hidden>No requests here yet. New tour and waitlist requests will appear here.</p>
      <div class="inbox-pagination"><button id="previous-page" disabled>← Previous</button><span id="page-description"></span><button id="next-page" disabled>Next →</button></div>
    </section>
  </main>
  <script src="../../scripts/requests-admin.ts"></script>
</body>
</html>
