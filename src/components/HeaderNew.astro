---
import { getEntry, getCollection } from 'astro:content';
import { groupLocations } from '../lib/portfolio.js';
import LocationMenuGroups from './LocationMenuGroups.astro';
const groups = groupLocations(await getCollection('locations'));
import ArrowIcon from './ArrowIcon.astro';

interface Props { leasingLocation?: string; leasingAvailable?: boolean; }
const { leasingLocation, leasingAvailable } = Astro.props;
const leasingAction = leasingAvailable === false ? 'Join the waitlist' : 'Request a tour';
const contact = (await getEntry('pages', 'contact'))!.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const homepage = await getEntry('pages', 'homepage');
const logo = homepage?.data?.logo || `${base}images/brand/getflexspace-color.svg`;
const currentPage = (href: string) => Astro.url.pathname.startsWith(href) ? 'page' : undefined;
---

<header class="gfs-header">
  <div class="gfs-header-inner">
    <a href={base} class="gfs-brand" aria-label="GetFlexSpace home">
      <img src={logo} alt="GetFlexSpace" width="1243" height="228" />
    </a>
    <nav aria-label="Main navigation" class="gfs-desktop-nav">
      <div class="gfs-locations-nav">
        <a href={`${base}locations/`} aria-current={currentPage(`${base}locations/`)}>Locations</a>
        <details class="gfs-location-menu"><summary aria-label="Show property locations"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div class="gfs-location-dropdown"><LocationMenuGroups groups={groups}/><a class="gfs-all-locations" href={`${base}locations/`}>View all locations <ArrowIcon size={18}/></a></div></details>
      </div>
      <a href={`${base}contact/`} aria-current={currentPage(`${base}contact/`)}>Contact</a>
    </nav>
    <div class="gfs-header-actions">
      <a href={`tel:${contact.phoneHref}`} class="gfs-call" aria-label="Call leasing">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.69A2 2 0 0 1 22 16.92Z"/></svg>
        <span>Call<span class="gfs-call-label"> leasing</span></span>
      </a>
      <a href={`${base}contact/`} data-property-inquiry={leasingLocation} data-request-type={leasingAvailable === false ? 'waitlist' : undefined} class="gfs-tour gfs-desktop-tour">{leasingAction}<ArrowIcon/></a>
      <details class="gfs-mobile-menu">
        <summary aria-label="Open menu" aria-controls="gfs-mobile-navigation">
          <svg class="gfs-menu-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          <svg class="gfs-menu-close" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg>
        </summary>
        <nav id="gfs-mobile-navigation" aria-label="Mobile navigation">
          <a href={`${base}locations/`} class="gfs-mobile-overview">All locations <ArrowIcon size={20}/></a>
          <LocationMenuGroups groups={groups}/>
          <a href={`${base}contact/`}>Contact</a>
          <a href={`${base}contact/`} data-property-inquiry={leasingLocation} data-request-type={leasingAvailable === false ? 'waitlist' : undefined} class="gfs-tour">{leasingAction}<ArrowIcon/></a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  import '../scripts/navigation';
</script>
<style>
  .gfs-header { position:sticky; top:0; z-index:50; margin:0; border:0; border-bottom:1px solid #d5d8ce; background:#f5f3ee; color:#202925; font:400 15px/1.5 Arial,Helvetica,sans-serif; letter-spacing:normal; }
  .gfs-header, .gfs-header * { box-sizing:border-box; }
  .gfs-header-inner { height:89px; padding:0 4.5%; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:24px; }
  .gfs-header a { color:inherit; text-decoration:none; transition:background .2s,color .2s; }
  .gfs-header :is(a,summary,button):focus-visible { outline:3px solid #b5611e; outline-offset:4px; }
  .gfs-brand { display:flex; width:195px; min-width:0; }
  .gfs-brand img { display:block; width:100%; height:auto; max-width:100%; }
  .gfs-desktop-nav { display:flex; align-items:center; gap:30px; max-width:none; }
  .gfs-desktop-nav > a, .gfs-locations-nav > a { display:flex; align-items:center; min-height:48px; padding:12px 0; font:inherit; }
  .gfs-desktop-nav a:hover, .gfs-mobile-menu nav>a:not(.gfs-tour):hover { color:#a95013; }
  .gfs-header-actions { display:flex; align-items:center; justify-content:flex-end; gap:24px; }
  .gfs-call { display:inline-flex; align-items:center; gap:8px; min-height:44px; white-space:nowrap; font:inherit; }
  .gfs-header svg { display:block; flex-shrink:0; width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  .gfs-call svg { width:18px; height:18px; }
  .gfs-header .gfs-tour { display:inline-flex; align-items:center; justify-content:space-between; min-height:48px; gap:30px; padding:12px 18px; border:0; border-radius:4px; background:#202925; color:white; font:600 15px/1.5 Arial,Helvetica,sans-serif; white-space:nowrap; }
  .gfs-header .gfs-tour:hover { background:#3b4a42; }
  .gfs-locations-nav { display:flex; align-items:center; gap:4px; }
  .gfs-location-menu summary { list-style:none; display:grid; place-items:center; width:32px; height:44px; cursor:pointer; border-radius:4px; }
  .gfs-location-menu summary::-webkit-details-marker { display:none; }
  .gfs-location-menu summary svg { width:16px; height:16px; }
  .gfs-location-menu[open] summary svg { transform:rotate(180deg); }
  .gfs-location-dropdown { position:absolute; top:100%; left:50%; transform:translateX(-50%); width:min(760px,calc(100vw - 32px)); padding:28px; background:#f5f3ee; border:1px solid #d5d8ce; border-radius:0 0 8px 8px; box-shadow:0 18px 30px #17231d18; }
  .gfs-location-dropdown .gfs-all-locations { display:flex; align-items:center; justify-content:space-between; min-height:48px; margin-top:18px; padding-top:18px; border-top:1px solid #d5d8ce; font-weight:600; }
  .gfs-mobile-menu { display:none; }
  .gfs-mobile-menu summary { display:flex; align-items:center; justify-content:center; width:44px; height:44px; margin:0; padding:10px; border:0; border-radius:4px; background:transparent; color:inherit; list-style:none; cursor:pointer; }
  .gfs-mobile-menu summary::-webkit-details-marker { display:none; }
  .gfs-mobile-menu summary:hover { background:#2029250a; }
  .gfs-mobile-menu .gfs-menu-close, .gfs-mobile-menu[open] .gfs-menu-open { display:none; }
  .gfs-mobile-menu[open] .gfs-menu-close { display:block; }
  @media (max-width:1100px) {
    .gfs-header-inner { padding:0 4%; gap:20px; }
    .gfs-brand { width:170px; }
    .gfs-header-actions { gap:15px; }
    .gfs-desktop-nav { gap:24px; }
  }
  @media (max-width:960px) {
    .gfs-header-inner { display:flex; justify-content:space-between; gap:12px; }
    .gfs-desktop-nav, .gfs-header .gfs-desktop-tour { display:none; }
    .gfs-header-actions { gap:8px; }
    .gfs-mobile-menu { display:block; }
    .gfs-mobile-menu nav { position:absolute; top:100%; left:0; right:0; display:flex; flex-direction:column; align-items:stretch; gap:8px; max-width:none; max-height:calc(100dvh - 90px); overflow-y:auto; padding:20px 4% 24px; border-bottom:1px solid #d5d8ce; background:#f5f3ee; box-shadow:0 14px 20px #17231d0d; }
    .gfs-mobile-menu nav>a { display:flex; align-items:center; min-height:48px; padding:12px 4px; font:400 18px/1.5 Arial,Helvetica,sans-serif; }
    .gfs-mobile-menu nav>.gfs-mobile-overview { justify-content:space-between; font-weight:600; }
    .gfs-mobile-menu nav>.gfs-tour { min-height:54px; margin-top:8px; padding:14px 18px; font:600 18px/1.5 Arial,Helvetica,sans-serif; }
  }
  @media (max-width:760px) {
    .gfs-header-inner { height:75px; padding:0 22px; }
    .gfs-brand { width:162px; }
    .gfs-mobile-menu nav { max-height:calc(100dvh - 76px); padding-left:22px; padding-right:22px; }
  }
  @media (max-width:380px) {
    .gfs-header-inner { padding:0 15px; }
    .gfs-brand { width:143px; }
    .gfs-call-label { display:none; }
    .gfs-mobile-menu nav { padding-left:15px; padding-right:15px; }
  }
</style>
