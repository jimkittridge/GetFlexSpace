---
import { getEntry } from 'astro:content';
interface Props { directory?: boolean; }
const { directory = false } = Astro.props;
const property = (await getEntry('retail', 'morganton-nc'))!.data;
const sizes = property.sizes.map(size => size.toLocaleString('en-US'));
const sizeRange = `${sizes[0]}–${sizes[sizes.length - 1]} sq ft`;
const image = property.media.find(item => item.category === 'Storefronts');
---
{directory ? <section id="retail-space" class="pb-20 lg:pb-28" aria-labelledby="retail-heading">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-10 max-w-3xl"><div class="text-sm uppercase tracking-[0.16em] text-black/45">Retail Space</div><h2 id="retail-heading" class="mt-3 text-4xl font-semibold tracking-[-0.03em] text-[#111]">Retail space for lease.</h2></div>
    <div class="grid gap-6 lg:grid-cols-3"><a href="/retail-space/" class="block overflow-hidden rounded-[30px] border border-black/10 bg-white shadow-[0_15px_40px_rgba(0,0,0,0.05)] no-underline transition hover:shadow-[0_20px_50px_rgba(0,0,0,0.1)]">
      {image && <div class="aspect-[4/3] overflow-hidden"><img src={image.image} alt={image.alt} class="h-full w-full object-cover transition duration-500 hover:scale-[1.03]" loading="lazy" width="1600" height="1032"/></div>}
      <div class="p-6"><div class="flex items-start justify-between gap-4"><div><h3 class="text-2xl font-semibold tracking-[-0.02em] text-[#111]">{property.city}, {property.state}</h3><div class="mt-1 text-sm text-black/50">{sizeRange}</div></div><span class="rounded-full px-3 py-1 text-xs font-medium shrink-0 bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200">Available now</span></div><p class="mt-4 text-sm leading-6 text-black/60">{property.address}. Both sizes available, with individual storefront entrances and a covered walkway.</p><div class="mt-5 flex items-center justify-between rounded-2xl border border-black/10 bg-[#fbfaf8] px-4 py-3 text-sm text-black/70"><span>Rent Retail Space in {property.city}</span><span aria-hidden="true">↗</span></div></div>
    </a></div>
  </div>
</section> : <section class="locations section" id="retail-space" aria-labelledby="retail-heading">
  <div class="section-heading"><div><p class="eyebrow">RETAIL SPACE</p><h2 id="retail-heading">Retail space for lease.</h2></div><p>Find your next storefront. Both 1,200 and 2,400 sq ft units are available in Morganton.</p></div>
  <div class="property-grid">
    <article class="property">
      {image && <a class="property-image" href="/retail-space/" aria-label="View Morganton retail property"><img src={image.image} alt={image.alt} loading="lazy" width="1600" height="1032"/><span class="status available"><i></i>Now leasing</span><span class="image-arrow" aria-hidden="true">↗</span></a>}
      <div class="property-heading"><h3>{property.city}, {property.state}</h3><span>04</span></div>
      <p class="property-description">Retail space at {property.address}, with individual storefront entrances and a covered walkway. Choose from 1,200 sq ft and 2,400 sq ft units.</p>
      <div class="property-facts"><span>{sizeRange}</span><span>Retail Space</span></div>
      <div class="property-bottom"><a href="/retail-space/#lead-form" class="property-cta property-cta-primary" data-tour="tour" data-location="Morganton">Request a tour <span aria-hidden="true">↗</span></a><a class="property-cta property-cta-secondary" href="/retail-space/">View Morganton property <span aria-hidden="true">↗</span></a></div>
    </article>
  </div>
</section>}
